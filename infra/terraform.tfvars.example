# 复制为 terraform.tfvars 后填写实际取值
# 凭据请勿写入本文件，统一通过环境变量 HW_ACCESS_KEY / HW_SECRET_KEY 注入

region               = "cn-north-4"
project_name         = "iam-key-rotation"
domain_name          = "your-huaweicloud-domain"
obs_bucket_name      = "iam-key-rotation-assets"
agency_name          = "iam-key-rotation-agency"
smn_topic_name       = "iam-key-rotation-topic"
email_subscription   = "ops@example.com"
function_memory      = 256
function_timeout     = 60
rotation_period_days = 90
inactive_period_days = 100
delete_period_days   = 110
target_user_filter   = ""
